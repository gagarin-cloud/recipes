# The web's own environment, passed with `gg ship ... --env-file .env`. None of
# it is secret: the bucket's keys arrive with `gg deps add speak/web files`, and
# the Gagarin token with `gg deps add speak/web gagarin`. Copy to .env.

# The project the web starts its runs in.
GAGARIN_PROJECT=speak

# The job image, as built by `gg build speak/tts:v1 --context ./tts --push`.
TTS_IMAGE=tts:v1

# The most runs this server starts in an hour. The address is public and every
# press of Speak is a GPU run; at a minute each, 30 an hour is $1.50 an hour.
RUNS_PER_HOUR=30
